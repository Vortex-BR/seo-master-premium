ADMIN_PASSWORD=replace-with-a-long-random-password
DATA_DIR=./data
COOKIE_SECURE=0
# Configure integrations in the application, or set these optional values.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
SUPADATA_API_KEY=
PEXELS_API_KEY=
PIXABAY_API_KEY=
YOUTUBE_PROXY_URLS=
# auto tries the server connection first, then saved proxies. Use proxy to require proxies.
YOUTUBE_CONNECTION_MODE=auto
# In production use COOKIE_SECURE=1 and an HTTPS APP_URL.
APP_URL=http://localhost:8000
# Editorial generation always uses Video-First with at most eight calls.
# Legacy EDITORIAL_FLOW / EDITORIAL_COMPOSITION values cannot reactivate old cycles.
# Local audio transcription has no per-minute API charge. Values can also be saved in the panel.
TRANSCRIPT_PROVIDER=local
WHISPER_MODEL=small
WHISPER_THREADS=2
AUDIO_MAX_MINUTES=180
AUDIO_MAX_MB=256
LOCAL_TRANSCRIPT_TIMEOUT=10800
TRANSCRIPT_TIMEOUT=180
SUPADATA_MODE=native
